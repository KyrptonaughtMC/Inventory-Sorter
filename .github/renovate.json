{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>stateshifters/renovate-common:deps"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "vulnerabilityAlerts": {
        "groupName": "vulnerability updates",
        "semanticCommitType": "docs"
      },
      "semanticCommitType": "docs",
      "automerge": true
    },
    {
      "matchManagers": [
        "gradle",
        "gradle-wrapper"
      ],
      "automerge": true,
      "semanticCommitType": "chore"
    }
  ]
}
